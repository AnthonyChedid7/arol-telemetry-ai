# Copy this file to ".env" (same folder) and fill in what you need.
# ".env" is ignored by Git, so your key never ends up in the repository.

# Optional: your own Anthropic API key, so Claude can understand everyday
# questions. Create one at https://console.anthropic.com (API keys).
# Without it everything still works with the offline rules.
ANTHROPIC_API_KEY=

# Optional: a private event pool to analyse instead of the synthetic demo data.
# AROL_MANIFEST=data/event_pools/<pool>/manifest.json

# Optional: force the synthetic demo data even if a private pool exists.
# AROL_DEMO=1
